# Copy to deploy/Caddyfile and replace the domain:
#   cp deploy/Caddyfile.example deploy/Caddyfile
#
# Start with HTTPS profile:
#   sudo docker compose -f docker-compose.prod.yml --profile https up -d

api.your-domain.com {
	encode gzip
	reverse_proxy api:3000
}

# Legal pages + landing (see deploy/WEB.md)
#   node scripts/build-legal-web.mjs
#   deploy web/ to /var/www/hyphen/web on VPS
your-domain.com, www.your-domain.com {
	encode gzip
	root * /var/www/hyphen/web
	file_server
	try_files {path} {path}/ {path}.html /index.html
}
