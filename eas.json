{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.14.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.hyphenjob.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "node": "22.14.0",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.hyphenjob.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "5MH48AUNP5"
      }
    }
  }
}
